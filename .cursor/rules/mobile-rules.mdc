## Code Examples

### 1\) Expo Router – Screen with React Query + Zod

```typescript
// apps/mobile/src/app/users/index.tsx
import { View, Text, FlatList } from 'react-native';
import { useUsersQuery } from '@/features/users/api/useUsersQuery';

export default function UsersScreen() {
  const { data, isLoading, isError } = useUsersQuery();

  if (isLoading) return <Text>Loading…</Text>;
  if (isError) return <Text>Failed to fetch users.</Text>;
  if (!data?.data?.length) return <Text>No users found.</Text>;

  return (
    <View>
      <FlatList
        data={data.data}
        keyExtractor={(u) => u.id}
        renderItem={({ item }) => <Text>{item.attributes.name}</Text>}
      />
    </View>
  );
}
```

### 2\) Query Provider (mobile)

```typescript
// apps/mobile/src/app/_layout.tsx
import { Stack } from 'expo-router';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { useState } from 'react';

export default function RootLayout() {
  const [client] = useState(() => new QueryClient({
    defaultOptions: { queries: { retry: 2, refetchOnReconnect: true } },
  }));

  return (
    <QueryClientProvider client={client}>
      <Stack screenOptions={{ headerShown: false }} />
    </QueryClientProvider>
  );
}
```

### 3\) JSON:API + Zod (shared contract)

```typescript
// packages/api-sdk/src/schemas/users.ts
import { z } from 'zod';

export const UserAttributes = z.object({
  name: z.string(),
  email: z.string().email(),
});

export const UserJsonApi = z.object({
  type: z.literal('users'),
  id: z.string(),
  attributes: UserAttributes,
});

export const UsersListResponse = z.object({
  data: z.array(UserJsonApi),
  meta: z.object({ total: z.number().optional() }).optional(),
});

export type UsersList = z.infer<typeof UsersListResponse>;
```

### 4\) Env in Expo (public)

```typescript
