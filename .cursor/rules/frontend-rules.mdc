Szablony startowe

Query Client (provider):
// shared/lib/queryClient.tsx
'use client';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { ReactNode, useState } from 'react';

export function QueryProvider({ children }: { children: ReactNode }) {
  const [client] = useState(() => new QueryClient({ defaultOptions: { queries: { retry: 2, refetchOnWindowFocus: false } } }));
  return <QueryClientProvider client={client}>{children}</QueryClientProvider>;
}
Route handler (BFF):
// app/api/users/route.ts
import { NextRequest, NextResponse } from 'next/server';
import { z } from 'zod';

const User = z.object({ id: z.string(), name: z.string(), email: z.string().email() });

export async function GET(_req: NextRequest) {
  const upstream = await fetch(process.env.UPSTREAM_URL + '/users', { headers: { Authorization: `Bearer ${process.env.API_TOKEN}` } });
  if (!upstream.ok) return NextResponse.json({ message: 'Upstream error' }, { status: upstream.status });
  const data = await upstream.json();
  return NextResponse.json(z.array(User).parse(data));
}
Strona (widok):
// features/users/pages/UsersPage.tsx
'use client';
import { useUsersQuery } from '../api/useUsersQuery';
import { Button } from '@/shared/ui/Button';

export default function UsersPage() {
  const { data, isPending, isError } = useUsersQuery();
  if (isPending) return <p>Ładowanie…</p>;
  if (isError) return <p>Nie udało się pobrać użytkowników.</p>;
  if (!data?.length) return <p>Brak użytkowników.</p>;
  return (
    <section>
      <header><h1>Użytkownicy</h1><Button>Dodaj</Button></header>
      <ul>{data.map(u => <li key={u.id}>{u.name}</li>)}</ul>
    </section>
  );
}
Polityka migracji/rozszerzeń
	•	Nowy feature: najpierw ADR + kontrakt API (Zod/OpenAPI), potem szkielet features/<name>.
	•	Ekstrakcja do shared/ui dopiero po trzecim użyciu.
	•	Zmiany łamiące: wersjonowanie endpointów w BFF (/api/v2/*), feature flags dla rolloutów.

